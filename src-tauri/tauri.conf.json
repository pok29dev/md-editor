{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Editor",
  "version": "26.8.801",
  "identifier": "com.mrpokx5.md-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 16, "y": 22 }
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$HOME/**",
            "$DOCUMENT/**",
            "$DESKTOP/**",
            "$DOWNLOAD/**",
            "/Volumes/**"
          ]
        }
      },
      "csp": {
        "default-src": "'self' 'unsafe-inline' 'unsafe-eval' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
        "frame-src": "'self' http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://127.0.0.1:* http://localhost:*",
        "style-src": "'unsafe-inline' 'self' http://127.0.0.1:* http://localhost:*",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:* http://localhost:*",
        "font-src": "'self' data: http://127.0.0.1:* http://localhost:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "mimeType": "text/markdown",
        "description": "Markdown Document",
        "rank": "Default"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
